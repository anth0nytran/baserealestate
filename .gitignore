# Dependencies
node_modules

# Build output — Vercel builds these from source on every deploy.
dist
dist-ssr
*.local

# Environment. Only .env.example is tracked; real values live in Vercel.
.env
.env.*
!.env.example

# Vercel
.vercel

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Local tooling and agent config
.claude
.playwright-mcp
output
coverage

# Editors
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ---------------------------------------------------------------------------
# Image originals — 25MB, and not needed to build or deploy.
#
# Everything the site actually serves is already derived into /public and is
# tracked. These are the high-resolution sources that
# scripts/prepare-brand-assets.mjs reads when regenerating them.
#
# They are kept out of the repo deliberately: Vercel never runs that script,
# so shipping 25MB to every clone and every deploy buys nothing. They live on
# the design machine. If you need to regenerate brand assets from a fresh
# clone, copy assets/renders/ across first.
# ---------------------------------------------------------------------------
assets/renders

# ---------------------------------------------------------------------------
# Parked article drafts.
#
# Inherited template content awaiting a rewrite. Nothing in this directory is
# built or published — vite.config.ts only reads src/content/blog — and it is
# kept out of the repo so the client-facing preview contains only finished
# work. The files remain on the working machine.
# ---------------------------------------------------------------------------
src/content/drafts

# Stray screenshots from local visual checks
/*.png
